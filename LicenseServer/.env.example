# License API
PORT=9530
PUBLIC_BASE_URL=http://localhost:9530
DATA_DIR=./data
TRIAL_DAYS=14
SESSION_DAYS=30
ADMIN_ACTIVATE_KEY=change-me-admin-key

# Stripe (overseas subscriptions)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Real Stripe Price IDs (price_...). Leave unset until billing is live.
# Placeholder values like price_xxx are treated as not ready.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_SUCCESS_URL=http://localhost:9530/checkout/success
STRIPE_CANCEL_URL=http://localhost:9530/checkout/cancel

# China pay is not offered in the add-in until a real unified-order call exists.
# cnReady stays false. Do not set CN_PAY_ALLOW_SIMULATE in production.
# CN_PAY_ALLOW_SIMULATE=1 is only for LicenseServer/test (it grants a seat).
CN_PAY_PROVIDER=simulate
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_APP_ID=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
CN_NOTIFY_URL=http://localhost:9530/webhooks/cn
CN_RETURN_URL=http://localhost:9530/checkout/success
CN_YEARLY_AMOUNT_FEN=19900

# Offline activation keys (route 1: manual payment + license key, no license server online).
# Overrides the default secret embedded in Bridges/LicenseKey.vb and Hosts/Shared/HostLicense.vb.
# Changing it invalidates every key issued before - update all three places and rebuild.
# LICENSE_KEY_SECRET=
