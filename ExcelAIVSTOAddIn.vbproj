    <Reference Include="YamlDotNet, Version=16.0.0.0, Culture=neutral, PublicKeyToken=ec19458f3c15af5e">

      <HintPath>$(NuGetPackageRoot)yamldotnet\16.3.0\lib\net47\YamlDotNet.dll</HintPath>

    </Reference>

    <PackageReference Include="YamlDotNet">

      <Version>16.3.0</Version>

    </PackageReference>



    <!-- 依赖注入：使用 Composition\AppServiceProvider.vb 中自实现的轻量级容器，

         以避免 Microsoft.Extensions.DependencyInjection 8.x 与 .NET Framework 4.7.2 的兼容性问题 -->



    <Reference Include="PresentationCore" />

    <Reference Include="PresentationFramework" />

    <Reference Include="WindowsBase" />

  </ItemGroup>

  <PropertyGroup>

    <VisualStudioVersion Condition="'$(VisualStudioVersion)' == ''">18.0</VisualStudioVersion>

    <VSToolsPath Condition="'$(VSToolsPath)' == ''">D:\Program Files\Microsoft Visual Studio\18\Community\MSBuild\Microsoft\VisualStudio\v$(VisualStudioVersion)</VSToolsPath>

  </PropertyGroup>

  <PropertyGroup>

    <OptionExplicit>On</OptionExplicit>

  </PropertyGroup>

  <PropertyGroup>

    <OptionCompare>Binary</OptionCompare>

  </PropertyGroup>

  <PropertyGroup>

    <OptionStrict>On</OptionStrict>

  </PropertyGroup>

  <PropertyGroup>

    <!-- 不再强杀 excel.exe：避免销毁用户未保存的工作簿。若 Excel 已加载本加载项导致 bin\Debug\ExcelAIVSTOAddIn.dll 被锁，构建会在复制步骤明确报错"文件正在使用"，此时请完全退出 Excel 重开（或用 msbuild /p:PreBuildEvent="exit 0" 跳过本事件）。仅清理无害的后台 OCR 宿主进程。
         一致性检查用 powershell 绝对路径：某些环境（精简 PATH 的 CI/构建机）里 PATH 上没有 powershell，
         写 "powershell" 会静默失败（"不是内部或外部命令"），工具定义漂移就没人拦了。 -->
    <PreBuildEvent>"%WINDIR%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -ExecutionPolicy Bypass -File "$(ProjectDir)Tools\check-tools-consistency.ps1" &amp; taskkill /F /IM OcrHost.exe 2&gt;nul &amp; exit 0</PreBuildEvent>

  </PropertyGroup>

  <PropertyGroup>

    <!-- ClickOnce 清单签名：VSTO 目标（Microsoft.VisualStudio.Tools.Office.targets 的
         VisualStudioForApplicationsBuild → VerifyClickOnceSigningSettings）强制要求
         SignManifests=true，设成 false 会直接报
         "Cannot build because the ClickOnce manifest signing option is not selected"
         （2026-10-26 实测：曾经按「方案 B」关掉，结果每次构建必失败）。
         密钥用仓库里已存在的 ExcelAIVSTOAddIn_TemporaryKey.pfx（与 Word 宿主同款做法），
         缺失时 VS 会自动重新生成一个临时密钥。
         ManifestCertificateThumbprint 也必须留着：Office 目标第 68 行把它映射成
         CertificateThumbprint 传给 ManageCertificateStore，删掉会报
         "未给任务 ManageCertificateStore 的必需参数 CertificateThumbprint 赋值"。 -->
    <SignManifests>true</SignManifests>
    <ManifestKeyFile>ExcelAIVSTOAddIn_TemporaryKey.pfx</ManifestKeyFile>
    <ManifestCertificateThumbprint>ED1AC12D8BB72993C13AFA541F279849D1A1DF27</ManifestCertificateThumbprint>

  </PropertyGroup>

  <PropertyGroup>

    <PublishUrl>bin\Release\</PublishUrl>

    <!-- 对外 ClickOnce 更新地址。留空时正式发布门禁失败。填公网 HTTPS 目录。 -->
    <InstallUrl></InstallUrl>

    <UpdateEnabled>true</UpdateEnabled>

    <UpdateMode>Foreground</UpdateMode>

    <UpdateInterval>7</UpdateInterval>

    <UpdateIntervalUnits>Days</UpdateIntervalUnits>

    <UpdatePeriodically>false</UpdatePeriodically>

    <UpdateRequired>false</UpdateRequired>

    <MapFileExtensions>true</MapFileExtensions>

    <ApplicationRevision>0</ApplicationRevision>

    <ApplicationVersion>1.0.0.0</ApplicationVersion>

    <UseApplicationTrust>false</UseApplicationTrust>

    <PublishWizardCompleted>true</PublishWizardCompleted>

    <BootstrapperEnabled>true</BootstrapperEnabled>

  </PropertyGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.VisualBasic.targets" />

  <Import Project="$(VSToolsPath)\OfficeTools\Microsoft.VisualStudio.Tools.Office.targets" Condition="'$(VSToolsPath)' != ''" />

  <ProjectExtensions>

    <VisualStudio>

      <FlavorProperties GUID="{BAA0C2D2-18E2-41B9-852F-F413020CAA33}">

        <ProjectProperties HostName="Excel" HostPackage="{29A7B9D7-A7F1-4328-8EF0-6B2D1A56B2C1}" OfficeVersion="15.0" VstxVersion="4.0" ApplicationType="Excel" Language="vb" TemplatesPath="" DebugInfoExeName="C:\Program Files\Microsoft Office\Root\Office16\EXCEL.EXE" DebugInfoCommandLine="/x" AddItemTemplatesGuid="{DCFE8D25-4715-4C33-9EAB-A34A9EBC9544}" />

        <Host Name="Excel" IconIndex="0">

          <HostItem Name="ThisAddIn" Code="ThisAddIn.vb" CanonicalName="AddIn" CanActivate="false" IconIndex="1" Blueprint="ThisAddIn.Designer.xml" GeneratedCode="ThisAddIn.Designer.vb" />

        </Host>

      </FlavorProperties>

    </VisualStudio>

  </ProjectExtensions>

  <ItemGroup>

    <Content Include="UI\**\*">

      <CopyToOutputDirectory>Always</CopyToOutputDirectory>

    </Content>

    <Content Update="UI\**\*.md" ExcludeFromBuild="true">

      <CopyToOutputDirectory>Never</CopyToOutputDirectory>

    </Content>

    <Content Update="UI\**\*.ps1" ExcludeFromBuild="true">

      <CopyToOutputDirectory>Never</CopyToOutputDirectory>

    </Content>

    <Content Update="UI\**\*.bak*" ExcludeFromBuild="true">

      <CopyToOutputDirectory>Never</CopyToOutputDirectory>

    </Content>

    <Content Update="UI\**\*.backup*" ExcludeFromBuild="true">

      <CopyToOutputDirectory>Never</CopyToOutputDirectory>

    </Content>

  </ItemGroup>

  <ItemGroup>

    <Content Include="Skills\*.md">

      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>

    </Content>

  </ItemGroup>

  <Target Name="SyncUIFiles" AfterTargets="Build">

    <Message Text="正在同步 UI 文件到输出目录..." Importance="high" />

    <Exec Command="robocopy &quot;$(ProjectDir)UI&quot; &quot;$(OutputPath)UI&quot; /E /NFL /NDL /NJH /NJS /XF *.ps1 *.bak* *.backup* .gitignore deploy-exclude.txt" IgnoreExitCode="true" />

    <Exec Command="robocopy &quot;$(ProjectDir)UI&quot; &quot;$(OutputPath)UI&quot; index.html /NFL /NDL /NJH /NJS" IgnoreExitCode="true" />

  </Target>

  <Target Name="SyncSkillsFiles" AfterTargets="Build">

    <Message Text=" 正在同步 Skills 文件到输出目录..." Importance="high" />

    <Exec Command="robocopy &quot;$(ProjectDir)Skills&quot; &quot;$(OutputPath)Skills&quot; *.md /NFL /NDL /NJH /NJS" IgnoreExitCode="true" />

  </Target>

  <Target Name="SyncUIDebugStamp" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Release'">

    <!-- 调用 Tools/sync-ui-to-debug.js：全量同步 UI 到 $(OutputPath)UI 并刷新版本戳。
         Debug/Release 都触发（原来仅 Debug，导致 Release 发布后 WebView2 仍缓存旧 JS）。
         必须显式传 dest 目标目录参数（脚本的 dest 选项）$(OutputPath)UI：脚本默认目标是 bin\Debug\UI，Release 下会刷错目录。

         脚本只写目标副本，不污染源文件；需要 node 在 PATH 上（项目 Tests/Tools 均依赖 node）。 -->

    <Message Text="运行 Tools/sync-ui-to-debug.js 同步 UI 并刷新版本戳 -> $(OutputPath)UI ..." Importance="high" />

    <Exec Command="node &quot;Tools\sync-ui-to-debug.js&quot; --dest &quot;$(OutputPath)UI&quot;" WorkingDirectory="$(ProjectDir)" />

  </Target>

  <Target Name="SyncBridgeFiles" AfterTargets="Build">

    <!-- 将本地桥(py-excel-bridge.py)与 UI 部署到 LocalAppData\ExcelAIVSTOAddIn\。
         目的：插件 DLL 在运行时可能从 ClickOnce/VS 影子缓存(assembly\dl3)加载，
         Assembly.Location 无法回溯到仓库 Tools/；而 LocalAppData 与加载位置无关、
         始终可达，且桥脚本的 UI_DIR(=Tools/../UI) 正好解析到部署后的真实 UI。 -->

    <Message Text="部署本地桥(py-excel-bridge)与 UI 到 LocalAppData..." Importance="high" />

    <Exec Command="robocopy &quot;$(ProjectDir)Tools&quot; &quot;$(LocalAppData)\ExcelAIVSTOAddIn\Tools&quot; py-excel-bridge.py /NFL /NDL /NJH /NJS" IgnoreExitCode="true" />

    <Exec Command="robocopy &quot;$(ProjectDir)UI&quot; &quot;$(LocalAppData)\ExcelAIVSTOAddIn\UI&quot; /E /NFL /NDL /NJH /NJS /XF *.ps1 *.bak* *.backup* .gitignore deploy-exclude.txt" IgnoreExitCode="true" />

  </Target>

<ItemGroup>
    <ProjectReference Include="Core\SmartPilot.Core.vbproj">
      <Project>{7C4E1A92-5D3B-4F81-9A62-8E1D4C7B3F55}</Project>
      <Name>SmartPilot.Core</Name>
    </ProjectReference>
    <ProjectReference Include="OcrHost\OcrHost.vbproj">
      <Project>{B7E4C1A2-6F58-4D3E-9C21-4A8E0F6D2B17}</Project>
      <Name>OcrHost</Name>
    </ProjectReference>
  </ItemGroup>
</Project>