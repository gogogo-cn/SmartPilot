      ],
      "displayName": "设置表格单元格格式",
      "intentKeywords": ["单元格", "表格格式", "底色", "表头", "cell"],
      "operationType": "Write",
      "isWrite": true,
      "isDangerous": false
    },
    {
      "name": "word_format_selected_table_cell",
      "layer": 1,
      "description": "设置【光标当前所在表格】的格式，整表或单个单元格皆可。\n\n⭐ 推荐：省略 row/col 即作用于整张表格。用户只说“设置表格对齐/颜色/字体/美化一下”，却没指明具体单元格时，直接调用本工具并省略 row/col，填入合理默认值（例如 align=center、headerBold=true、headerFillColor=#D9D9D9）即可，严禁反问用户行号/列号/颜色值。\n\n仅当用户明确只想改某一格（如“把第1行第2列居中”）时才传 row/col（从 1 开始）。\n\n整表模式语义：align/fontSize/fontName/fontColor/borderColor 作用于所有单元格；bold/fillColor（或 headerBold/headerFillColor）作用于表头行（第 1 行）。\n\n⚠️ 调用前需光标已在目标表格内。",
      "parameters": [
        { "name": "row", "type": "integer", "required": false, "description": "行号（从 1 开始）；省略则整表生效" },
        { "name": "col", "type": "integer", "required": false, "description": "列号（从 1 开始）；省略则整表生效" },
        { "name": "align", "type": "string", "required": false, "description": "水平对齐 left/center/right" },
        { "name": "headerBold", "type": "boolean", "required": false, "description": "表头行(第1行)加粗" },
        { "name": "headerFillColor", "type": "string", "required": false, "description": "表头行底色 #RRGGBB" },
        { "name": "fontSize", "type": "number", "required": false, "description": "字号" },
        { "name": "fontName", "type": "string", "required": false, "description": "字体名" },
        { "name": "fontColor", "type": "string", "required": false, "description": "字体颜色 #RRGGBB" },
        { "name": "bold", "type": "boolean", "required": false, "description": "整表模式下等同 headerBold；单元格模式下作用于该格" },
        { "name": "italic", "type": "boolean", "required": false, "description": "是否斜体" },
        { "name": "fillColor", "type": "string", "required": false, "description": "整表模式下等同 headerFillColor；单元格模式下作用于该格" },
        { "name": "borderColor", "type": "string", "required": false, "description": "边框颜色 #RRGGBB" },
        { "name": "borderStyle", "type": "string", "required": false, "description": "边框版式：all 全网格（默认）/ none 无边框 / horizontal 仅横线 / outer 仅外框 / threeLine 三线表（学术：顶线+表头下线+底线）。需与 borderColor 一起给" },
        { "name": "headerFontColor", "type": "string", "required": false, "description": "表头字体色 #RRGGBB（深底表头配 #FFFFFF 白字）" },
        { "name": "headerItalic", "type": "boolean", "required": false, "description": "表头斜体（斜体表头版式）" },
        { "name": "zebraColor", "type": "string", "required": false, "description": "隔行底纹色 #RRGGBB；给了它即默认开启隔行底纹" },
        { "name": "firstColBold", "type": "boolean", "required": false, "description": "首列加粗（左侧标题列）+ 极浅底" },
        { "name": "lastRowBold", "type": "boolean", "required": false, "description": "末行（合计行）加粗 + 上边线" },
        { "name": "bodyAlign", "type": "string", "required": false, "description": "正文对齐 left/center/right，覆盖整表 align（常用于“表头居中 + 正文左对齐/数字右对齐”）" },
        { "name": "rowHeight", "type": "number", "required": false, "description": "行高磅值：紧凑 16 / 标准 22 / 宽松 30" },
        { "name": "valign", "type": "string", "required": false, "description": "垂直对齐 middle 居中（默认）/ top 顶端" },
        { "name": "highlightColor", "type": "string", "required": false, "description": "文本突出颜色(高亮笔) #RRGGBB 或颜色名（黄/红/蓝/绿/青/粉/紫/黑/白）；与字体颜色 fontColor 不同，是文字背景荧光色。Word 取最近高亮调色板、PPT 取最接近 RGB" },
        { "name": "zebra", "type": "boolean", "required": false, "description": "是否启用隔行底纹：正文偶数行（第2、4、6…行）着浅色，让表格更精致；与 clearFill 互斥。浅色由表头底色派生（同色系更浅），未给表头底色时取浅灰。美化/主题指令默认开启。" }
      ],
      "displayName": "设置当前表格格式（可整表）",
      "intentKeywords": ["当前表格", "光标表格", "单元格", "表格格式", "底色", "对齐", "居中", "cell"],
      "operationType": "Write",
      "isWrite": true,
      "isDangerous": false
    },
